<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Khai báo TƯỜNG MINH và KHÔNG private, dù Design package đã kéo EF Core vào.
         Lý do: Design có PrivateAssets=all nên phiên bản của nó (10.0.11) không chảy
         sang project khác, còn provider Npgsql 10.0.3 chỉ khai báo phụ thuộc EF Core
         10.0.4. Project này biên dịch với 10.0.11 nhưng consumer nhận 10.0.4 -> CS1705
         "uses a higher version than referenced assembly". Da gap that khi them test project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KnowledgePlatform.Domain\KnowledgePlatform.Domain.csproj" />
  </ItemGroup>

</Project>
